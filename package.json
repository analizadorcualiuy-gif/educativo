{
  "name": "analizador-cuali-uy-pro",
  "version": "1.0.4",
  "description": "AnalizadorCualiUY Pro - Edición comercial de escritorio para análisis cualitativo local y confidencial",
  "author": "Prof. Esp. Santiago Hernández",
  "license": "SEE LICENSE IN EULA.txt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File ./serve-dev.ps1",
    "build:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-frontend.ps1 -OutputDirectory dist -Minify",
    "build": "tauri build -- --locked",
    "minify": "terser app.js -o app.min.js --compress --mangle",
    "legal:generate": "node tools/generate-third-party-inventory.mjs",
    "legal:check": "node tools/generate-third-party-inventory.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "terser": "^5.39.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "mammoth": "^1.12.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108"
  }
}
